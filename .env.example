# The API the website talks to. NEXT_PUBLIC_* is inlined at build time.
#
#   local backend      http://localhost:5000/api
#   Render service     https://pg-backend-pozw.onrender.com/api
#   your own subdomain https://api.pzee.in/api   <- recommended, see below
#
# The session cookie is why the subdomain matters: a cookie from
# onrender.com is third-party to pzee.in, and Safari and Firefox block those
# by default. Pointing api.pzee.in at the Render service makes it first-party.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
